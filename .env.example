# ─────────────────────────────────────────────────────────────────────────────
# Fit Planet environment variables
# Copy to `.env.local` for development, or to /var/www/fitplanet/shared/.env on
# the Lightsail server. Every feature switches itself off when its keys are
# empty, so you can start with only the "Required" block filled in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash. Used in emails, payment redirects
# and OAuth callbacks.
APP_URL=http://localhost:3000

# MongoDB connection string (Atlas or self-hosted) and database name.
DB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fitplanet

# Random secret that signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Sign-in providers (optional) ─────────────────────────────────────────────

# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook: developers.facebook.com > your app > Facebook Login
# Valid OAuth redirect URI: {APP_URL}/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# ── Email (magic links, password resets, booking receipts) ───────────────────

# "smtp" or "console". Defaults to smtp when SMTP_HOST is set, otherwise emails
# are printed to the server log. Magic link sign-in is hidden in production
# until SMTP is configured.
EMAIL_PROVIDER=
EMAIL_FROM="Fit Planet <no-reply@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Payments ─────────────────────────────────────────────────────────────────

# "stripe" or "mock". Defaults to stripe when STRIPE_SECRET_KEY is set. The mock
# provider shows a fake checkout page so the whole flow works without keys.
PAYMENT_PROVIDER=
# dashboard.stripe.com > Developers > API keys (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
# dashboard.stripe.com > Developers > Webhooks > add endpoint
#   URL:    {APP_URL}/api/webhooks/payments/stripe
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.expired,
#           checkout.session.async_payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=
# The mock gateway confirms bookings without charging. In production it is
# off unless this is true (use only on a staging server).
ALLOW_MOCK_PAYMENTS=false
# Let members choose "pay at the front desk". Set to false to require online payment.
ALLOW_PAY_AT_DESK=true
# Platform commission per booking, as a fraction (0.1 = 10%). Shown to owners.
PLATFORM_FEE=0.1

# ── Media storage ────────────────────────────────────────────────────────────

# "local" stores files on the server disk (served by nginx at /media).
# "s3" works with Cloudflare R2, AWS S3, Lightsail buckets or any S3-compatible store.
STORAGE_PROVIDER=local
# Local folder for uploads. On Lightsail: /var/www/fitplanet/shared/uploads
STORAGE_LOCAL_DIR=./storage/uploads
# Public base URL for stored files. "/media" for local; for R2 use your public
# bucket URL, e.g. https://media.yourdomain.com
STORAGE_PUBLIC_URL=/media
STORAGE_MAX_UPLOAD_MB=8

# Only for STORAGE_PROVIDER=s3. For R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────

# "fcm" or "console". Defaults to fcm when FIREBASE_SERVICE_ACCOUNT is set,
# otherwise pushes are only logged (in-app notifications still work).
PUSH_PROVIDER=
# Server key: Firebase console > Project settings > Service accounts >
# Generate new private key. Paste the JSON on one line, or base64 encode it:
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=

# Public web config: Firebase console > Project settings > General > Your apps >
# Web app > SDK setup and configuration. These are safe to expose to browsers,
# but they are baked in at build time, so in production set them as GitHub
# repository variables too (see NEEDS_FROM_USER.md).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Project settings > Cloud Messaging > Web Push certificates > Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Scheduled jobs ───────────────────────────────────────────────────────────

# Shared secret for POST /api/cron/hourly (pass reminders, releasing abandoned
# checkouts). setup-server.sh installs a crontab that sends it. Generate with:
# openssl rand -hex 24. Leave empty to disable the endpoint.
CRON_SECRET=

# ── Scripts ──────────────────────────────────────────────────────────────────

# Password for the demo accounts created by `bun run db:seed`
# (owner@fitplanet.dev and member@fitplanet.dev). Defaults to fitplanet123.
SEED_PASSWORD=
